de(_EXTRACT_SENTENCES_PY_B64))\n","pathlib.Path(\"pipeline.py\").write_bytes(base64.b64decode(_PIPELINE_PY_B64))\n","\n","import sys\n","if \".\" not in sys.path:\n","    sys.path.insert(0, \".\")\n","\n","# Reload in case an earlier run of this cell already imported stale versions\n","for _mod in (\"normalize\", \"extract_sentences\", \"pipeline\"):\n","    sys.modules.pop(_mod, None)\n","\n","from normalize import normalize_transliteration, normalize_translation\n","from extract_sentences import extract_sentences_for_doc\n","import pipeline as sentence_pipeline\n","\n","print(\"normalize.py / extract_sentences.py / pipeline.py written and imported.\")\n"]},{"cell_type":"code","execution_count":6,"id":"30499f7c","metadata":{"execution":{"iopub.execute_input":"2026-09-12T10:59:14.725274Z","iopub.status.busy":"2026-09-12T10:59:14.724696Z","iopub.status.idle":"2026-09-12T10:59:16.501842Z","shell.execute_reply":"2026-09-12T10:59:16.500439Z"},"papermill":{"duration":1.783342,"end_time":"2026-09-12T10:59:16.504163+00:00","exception":false,"start_time":"2026-09-12T10:59:14.720821+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Built sentence_dataset.csv (8415 sentence pairs). Stats:\n","  docs_in_published: 7949\n","  docs_in_sentences: 1700\n","  docs_usable_intersection: 1417\n","  sentences_total_in_usable_docs: 8476\n","  pairs_extracted: 8415\n","  anchors_failed: 61\n","  rows_with_foreign_chars: 2\n","  anchor_success_rate: 99.3%\n"]}],"source":["import os\n","\n","COMP_DIR = \"/kaggle/input/competitions/deep-past-initiative-machine-translation\"\n","SENTENCE_DATASET_PATH = \"sentence_dataset.csv\"\n","EXTRACTION_REPORT_PATH = \"extraction_report.txt\"\n","\n","if os.path.exists(SENTENCE_DATASET_PATH):\n","    print(f\"Found cached {SENTENCE_DATASET_PATH}, reusing it (delete the file to force a rebuild).\")\n","else:\n","    published_rows = sentence_pipeline.load_csv(os.path.join(COMP_DIR, \"published_texts.csv\"))\n","    sentence_rows = sentence_pipeline.load_csv(os.path.join(COMP_DIR, \"Sentences_Oare_FirstWord_LinNum.csv\"))\n","\n","    pairs, failed, foreign_log, stats = sentence_pipeline.build_dataset(published_rows, sentence_rows)\n","    pairs = sentence_pipeline.split_by_document(pairs, val_fraction=0.1, seed=42)\n","\n","    sentence_pipeline.write_dataset(pairs, SENTENCE_DATASET_PATH)\n","    sentence_pipeline.write_report(stats, failed, foreign_log, EXTRACTION_REPORT_PATH)\n","\n","    print(f\"Built {SENTENCE_DATASET_PATH} ({len(pairs)} sentence pairs). Stats:\")\n","    for k, v in stats.items():\n","        print(f\"  {k}: {v}\")\n","    if stats[\"sentences_total_in_usable_docs\"]:\n","        rate = 100 * (1 - stats[\"anchors_failed\"] / stats[\"sentences_total_in_usable_docs\"])\n","        print(f\"  anchor_success_rate: {rate:.1f}%\")\n"]},{"cell_type":"code","execution_count":7,"id":"ef3a5e70","metadata":{"execution":{"iopub.execute_input":"2026-09-12T10:59:16.515605Z","iopub.status.busy":"2026-09-12T10:59:16.514996Z","iopub.status.idle":"2026-09-12T10:59:20.122119Z","shell.execute_reply":"2026-09-12T10:59:20.121429Z"},"papermill":{"duration":3.61412,"end_time":"2026-09-12T10:59:20.123788+00:00","exception":false,"start_time":"2026-09-12T10:59:16.509668+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import pandas as pd\n","from datasets import Dataset, DatasetDict\n","\n","# Load the pre-built sentence-level dataset (see the pipeline cells above) instead of\n","# train.csv — train.csv is document-level and barely overlaps with the sentence-level\n","# sources, so it isn't usable for a model that must translate sentence-by-sentence\n","# like test.csv (see sentence_dataset_README.md).\n","df = pd.read_csv(SENTENCE_DATASET_PATH)\n","df = df.dropna(subset=[\"transliteration\", \"translation\"]).reset_index(drop=True)\n","\n","# Use the split already computed by document (not a fresh random split!) — splitting\n","# by row would leak a document's style/lexicon between train and val and inflate the\n","# val metric (see README section 2).\n","train_df = df[df[\"split\"] == \"train\"].reset_index(drop=True)\n","val_df = df[df[\"split\"] == \"val\"].reset_index(drop=True)\n","\n","dataset = DatasetDict({\n","    \"train\": Dataset.from_pandas(train_df),\n","    \"validation\": Dataset.from_pandas(val_df)\n","})\n"]},{"cell_type":"code","execution_count":8,"id":"d5a0469a","metadata":{"execution":{"iopub.execute_input":"2026-09-12T10:59:20.131804Z","iopub.status.busy":"2026-09-12T10:59:20.131471Z","iopub.status.idle":"2026-09-12T10:59:51.66443Z","shell.execute_reply":"2026-09-12T10:59:51.661976Z"},"papermill":{"duration":31.84898,"end_time":"2026-09-12T10:59:51.976197+00:00","exception":false,"start_time":"2026-09-12T10:59:20.127217+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"289e10a4e8144c2d83d649d608b55ba3","version_major":2,"version_minor":0},"text/plain":["Map:   0%|          | 0/7656 [00:00<?, ? examples/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"2bd1d173c5b74e188db44e57a9f26597","version_major":2,"version_minor":0},"text/plain":["Map:   0%|          | 0/750 [00:00<?, ? examples/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"7e709e7cadce456cafd1299e250b3f57","version_major":2,"version_minor":0},"text/plain":["Loading weights:   0%|          | 0/516 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"}],"source":["import torch\n","from transformers import AutoTokenizer, AutoModelForSeq2SeqLM, DataCollatorForSeq2Seq, set_seed\n","\n","# Set global random seed for reproducibility\n","set_seed(42)\n","\n","MODEL_NAME = \"facebook/mbart-large-50-many-to-many-mmt\"\n","# Local/attached-dataset path used in offline mode (no internet download).\n","MODEL_PATH = \"/kaggle/input/models/nensipansuriya1311/facebookmbart-large-50-many-to-many-mmt/pytorch/default/1\"\n","\n","MODEL_SOURCE = MODEL_NAME if IS_ONLINE else MODEL_PATH\n","\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_SOURCE)\n","\n","# Set language tokens: Akkadian isn't in standard mBART's vocabulary,\n","# so we reuse an existing language code for both source and target\n","tokenizer.src_lang = \"en_XX\"\n","tokenizer.tgt_lang = \"en_XX\"\n","\n","# Kept at 256 despite English translation length p95≈413 / p99≈713 tokens —\n","# anything higher OOMs on Kaggle's T4. The tail of long translations is truncated;\n","# see the memory-optimization notes in the training-args and inference cells for\n","# what's being done to compensate elsewhere in the pipeline.\n","MAX_SOURCE_LENGTH = 256\n","MAX_TARGET_LENGTH = 256\n","\n","def preprocess_function(examples):\n","    inputs = examples[\"transliteration\"]\n","    targets = examples[\"translation\"]\n","\n","    model_inputs = tokenizer(\n","        inputs,\n","        max_length=MAX_SOURCE_LENGTH,\n","        truncation=True,\n","        padding=False\n","    )\n","\n","    labels = tokenizer(\n","        text_target=targets,\n","        max_length=MAX_TARGET_LENGTH,\n","        truncation=True,\n","        padding=False\n","    )\n","\n","    model_inputs[\"labels\"] = labels[\"input_ids\"]\n","    return model_inputs\n","\n","tokenized_datasets = dataset.map(\n","    preprocess_function,\n","    batched=True,\n","    remove_columns=dataset[\"train\"].column_names\n",")\n","\n","model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_SOURCE)\n"]},{"cell_type":"markdown","id":"190908d9","metadata":{"papermill":{"duration":0.0035,"end_time":"2026-09-12T10:59:51.983294+00:00","exception":false,"start_time":"2026-09-12T10:59:51.979794+00:00","status":"completed"},"tags":[]},"source":["## Metrics — manual implementation\n","\n","Pure-Python BLEU / chrF++, no `evaluate`/`sacrebleu` dependency. This avoids a metric-script download from the Hugging Face Hub, which `evaluate.load(...)` would otherwise require even in \"online\" mode."]},{"cell_type":"code","execution_count":9,"id":"1af5d916","metadata":{"execution":{"iopub.execute_input":"2026-09-12T10:59:51.992646Z","iopub.status.busy":"2026-09-12T10:59:51.991513Z","iopub.status.idle":"2026-09-12T10:59:52.005843Z","shell.execute_reply":"2026-09-12T10:59:52.004989Z"},"papermill":{"duration":0.020666,"end_time":"2026-09-12T10:59:52.007424+00:00","exception":false,"start_time":"2026-09-12T10:59:51.986758+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import math\n","from collections import Counter\n","import numpy as np\n","\n","def _ngram_counts(tokens, n):\n","    return Counter(tuple(tokens[i:i+n]) for i in range(len(tokens) - n + 1))\n","\n","def corpus_bleu(preds, refs, max_n=4):\n","    clipped_counts = [0] * max_n\n","    total_counts = [0] * max_n\n","    pred_len_total, ref_len_total = 0, 0\n","    for pred, ref in zip(preds, refs):\n","        p_tokens, r_tokens = pred.split(), ref.split()\n","        pred_len_total += len(p_tokens)\n","        ref_len_total += len(r_tokens)\n","        for n in range(1, max_n + 1):\n","            p_counts = _ngram_counts(p_tokens, n)\n","            r_counts = _ngram_counts(r_tokens, n)\n","            clipped_counts[n - 1] += sum(min(c, r_counts[g]) for g, c in p_counts.items())\n","            total_counts[n - 1] += max(sum(p_counts.values()), 0)\n","    precisions = [clipped_counts[n] / total_counts[n] if total_counts[n] > 0 else 0.0 for n in range(max_n)]\n","    geo_mean = 0.0 if min(precisions) == 0 else math.exp(sum(math.log(p) for p in precisions) / max_n)\n","    bp = 1.0 if pred_len_total > ref_len_total else math.exp(1 - ref_len_total / max(pred_len_total, 1))\n","    return 100.0 * bp * geo_mean\n","\n","def corpus_chrf(preds, refs, n=6, beta=2):\n","    tp = [0] * n; tt = [0] * n; rc = [0] * n; rt = [0] * n\n","    for pred, ref in zip(preds, refs):\n","        p_chars, r_chars = pred.replace(\" \", \"\"), ref.replace(\" \", \"\")\n","        for k in range(1, n + 1):\n","            p_counts, r_counts = _ngram_counts(p_chars, k), _ngram_counts(r_chars, k)\n","            overlap = sum((p_counts & r_counts).values())\n","            tp[k - 1] += overlap; tt[k - 1] += max(sum(p_counts.values()), 0)\n","            rc[k - 1] += overlap; rt[k - 1] += max(sum(r_counts.values()), 0)\n","    precisions = [tp[k] / tt[k] if tt[k] > 0 else 0.0 for k in range(n)]\n","    recalls = [rc[k] / rt[k] if rt[k] > 0 else 0.0 for k in range(n)]\n","    avg_p, avg_r = sum(precisions) / n, sum(recalls) / n\n","    if avg_p + avg_r == 0:\n","        return 0.0\n","    beta2 = beta ** 2\n","    return 100.0 * (1 + beta2) * avg_p * avg_r / (beta2 * avg_p + avg_r)\n","\n","def compute_metrics(eval_preds):\n","    preds, labels = eval_preds\n","    if isinstance(preds, tuple):\n","        preds = preds[0]\n","\n","    # Replace -100 in labels so they decode correctly\n","    preds = np.where(preds != -100, preds, tokenizer.pad_token_id)\n","    labels = np.where(labels != -100, labels, tokenizer.pad_token_id)\n","\n","    decoded_preds = tokenizer.batch_decode(preds, skip_special_tokens=True)\n","    decoded_labels = tokenizer.batch_decode(labels, skip_special_tokens=True)\n","\n","    decoded_preds = [pred.strip() for pred in decoded_preds]\n","    decoded_labels = [label.strip() for label in decoded_labels]\n","\n","    chrf_pp = corpus_chrf(decoded_preds, decoded_labels)  # beta=2 approximates chrF++\n","    bleu = corpus_bleu(decoded_preds, decoded_labels)\n","\n","    return {\n","        \"chrf_pp\": round(chrf_pp, 4),\n","        \"bleu\": round(bleu, 4)\n","    }\n"]},{"cell_type":"markdown","id":"87412a93","metadata":{"papermill":{"duration":0.003738,"end_time":"2026-09-12T10:59:52.014649+00:00","exception":false,"start_time":"2026-09-12T10:59:52.010911+00:00","status":"completed"},"tags":[]},"source":["## Training\n","\n","Memory optimizations added on top of the original setup (all safe to use in both modes):\n","\n","- **`group_by_length=True`** — batches similar-length examples together so padding waste (and the peak activation memory that comes with it) is minimized, instead of a batch occasionally pairing a short and a near-256-token example.\n","- **`eval_accumulation_steps=1`** — with `predict_with_generate=True`, the Trainer otherwise keeps *all* generated eval predictions resident on the GPU until the full eval pass finishes; this was the most likely source of eval-time OOM, independent of `MAX_TARGET_LENGTH`. Setting this moves each batch's predictions to CPU immediately.\n","- **Explicit `use_cache` toggling** — `use_cache=True` (the default, used by `.generate()`) is incompatible with `gradient_checkpointing=True` and silently wastes memory/emits warnings during training if left on. It's turned off before `trainer.train()` and back on before generation/prediction."]},{"cell_type":"code","execution_count":10,"id":"2ce11469","metadata":{"execution":{"iopub.execute_input":"2026-09-12T10:59:52.023475Z","iopub.status.busy":"2026-09-12T10:59:52.022741Z","iopub.status.idle":"2026-09-12T12:37:38.758009Z","shell.execute_reply":"2026-09-12T12:37:38.756538Z"},"papermill":{"duration":5866.741499,"end_time":"2026-09-12T12:37:38.759819+00:00","exception":false,"start_time":"2026-09-12T10:59:52.01832+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/torch/autograd/function.py:583: UserWarning: Was asked to gather along dimension 0, but all input tensors were scalars; will instead unsqueeze and return a vector.\n","  return super().apply(*args, **kwargs)  # type: ignore[misc]\n"]},{"data":{"text/html":["\n","    <div>\n","      \n","      <progress value='2395' max='2395' style='width:300px; height:20px; vertical-align: middle;'></progress>\n","      [2395/2395 1:35:27, Epoch 5/5]\n","    </div>\n","    <table border=\"1\" class=\"dataframe\">\n"